# Copy this file to .env and fill in every value.
# .env is gitignored - never commit it.

# --- Django ---
# Signing key for sessions. Generate with: openssl rand -hex 32
SECRET_KEY=

# --- GitHub ---
# Owner of the rdgen fork that runs the compile workflows.
GHUSER=yourgithubusername
# Fine-grained personal access token: scope = this repo only,
# permission = Actions: Read and write.
GHBEARER=yourgithubtoken
GHBRANCH=master
REPONAME=rdgen

# --- Public access ---
# The URL GitHub Actions uses to call this server back.
# Set PROTOCOL=https whenever GENURL is behind a tunnel or reverse proxy.
GENURL=http://yourdomain:8000
PROTOCOL=https

# --- Build secrets ---
# Encrypts the config zip handed to GitHub Actions.
# Generate with: openssl rand -hex 32
# MUST be identical to the ZIP_PASSWORD secret set in the GitHub repo,
# otherwise Actions cannot decrypt the zip and the build never starts.
ZIP_PASSWORD=

# --- Optional ---
# Shared secret for the external (non web-UI) API path. Leave blank if unused.
SH_SECRET=
# Gunicorn sizing. Defaults (3 workers / 2 threads) suit SQLite; raise only
# if you move off SQLite, since extra workers contend for the write lock.
GUNICORN_WORKERS=3
GUNICORN_THREADS=2

# --- Cloudflare tunnel ---
# Token from Cloudflare Zero Trust > Networks > Tunnels.
# Required only when running: docker compose --profile tunnel up -d
TUNNEL_TOKEN=
