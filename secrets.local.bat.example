@echo off
REM ============================================================
REM  本地密钥模板 —— 复制为 secrets.local.bat 后填入真实值
REM
REM    cp secrets.local.bat.example secrets.local.bat
REM    notepad secrets.local.bat
REM
REM  secrets.local.bat 已在 .gitignore 与 .dockerignore 中，
REM  不会被 git 追踪、也不会被打进 Docker 镜像。
REM  start_rdgen.bat 启动时会自动 call 本文件（如果存在）。
REM
REM  下方全部为占位符，提交仓库请只提交本 .example 模板。
REM ============================================================

REM --- GitHub 用户名（你 fork rdgen 的账号）---
REM set GHUSER=yourgithubusername

REM --- GitHub fine-grained PAT（Actions: Read and write）---
REM set GHBEARER=yourgithubtoken

REM --- 公网访问地址（Actions 用此 URL 回调本服务器）---
REM 本地：http://localhost:8000   公网隧道/域名：https://yourdomain:8000
REM set GENURL=http://yourdomain:8000
REM set PROTOCOL=https

REM --- Django SECRET_KEY（保持服务重启后 session 不断）---
REM set SECRET_KEY=your_random_django_secret_key

REM --- 产物加密密码（必须与 GitHub Secret ZIP_PASSWORD 完全一致）---
REM set ZIP_PASSWORD=your_random_hex_string
