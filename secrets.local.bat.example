@echo off
REM ============================================================
REM  本地密钥模板 —— 复制为 secrets.local.bat 后填入真实值
REM
REM  cp secrets.local.bat.example secrets.local.bat
REM  notepad secrets.local.bat
REM
REM  secrets.local.bat 已在 .gitignore 中，不会被 git 追踪，
REM  适合放 GHBEARER / SECRET_KEY / ZIP_PASSWORD 这类不该进公开仓库的值。
REM
REM  start_rdgen.bat 启动时会自动 call 本文件（如果存在）。
REM ============================================================

REM --- GitHub fine-grained PAT（Actions: Read and write）---
REM set GHBEARER=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

REM --- Django SECRET_KEY（保持服务重启后浏览器 session 不断）---
REM set SECRET_KEY=your_random_django_secret_key

REM --- 产物加密密码（必须与 GitHub Secret ZIP_PASSWORD 完全一致）---
REM set ZIP_PASSWORD=your_random_hex_string